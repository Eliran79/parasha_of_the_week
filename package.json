{
  "name": "parasha-of-the-week",
  "version": "1.0.0",
  "description": "Parasha of the Week — Hebrew Torah blog as a native mobile app",
  "private": true,
  "scripts": {
    "build": ".venv/bin/python3 scripts/build.py",
    "sync": "npx cap sync",
    "build:sync": ".venv/bin/python3 scripts/build.py && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/assets": "^3.0.5"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
